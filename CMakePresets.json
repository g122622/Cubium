{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "windows-clang-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "D:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "D:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_RC_COMPILER": "D:/Windows Kits/10/bin/10.0.26100.0/x64/rc.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows Clang Debug",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "ON",
        "MC_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-clang-relwithdebinfo",
      "displayName": "Windows Clang RelWithDebInfo",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "ON",
        "MC_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows Clang Release",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "OFF",
        "MC_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-clang-relwithdebinfo-noprof",
      "displayName": "Windows Clang RelWithDebInfo (no profiler)",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build-noprof",
      "installDir": "${sourceDir}/dist-noprof",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "ON",
        "MC_ENABLE_SANITIZERS": "OFF",
        "MC_ENABLE_TRACING": "OFF",
        "MC_ENABLE_TRACY": "OFF",
        "MC_ENABLE_MEMORY": "OFF"
      }
    },
    {
      "name": "windows-clang-release-noprof",
      "displayName": "Windows Clang Release (no profiler, distributable)",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build-release-noprof",
      "installDir": "${sourceDir}/dist-release-noprof",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "OFF",
        "MC_BUILD_BENCHMARKS": "OFF",
        "MC_ENABLE_SANITIZERS": "OFF",
        "MC_ENABLE_VULKAN_VALIDATION": "OFF",
        "MC_ENABLE_TRACING": "OFF",
        "MC_ENABLE_TRACY": "OFF",
        "MC_ENABLE_MEMORY": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "ON",
        "MC_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "OFF",
        "MC_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "macos-relwithdebinfo",
      "displayName": "macOS RelWithDebInfo",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "ON",
        "MC_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "server-only",
      "displayName": "Server Only",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MC_BUILD_CLIENT": "OFF",
        "MC_BUILD_SERVER": "ON",
        "MC_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "client-only",
      "displayName": "Client Only",
      "inherits": "windows-clang-base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/dist",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MC_BUILD_CLIENT": "ON",
        "MC_BUILD_SERVER": "OFF",
        "MC_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "configuration": "Debug",
      "jobs": 16
    },
    {
      "name": "windows-clang-relwithdebinfo",
      "configurePreset": "windows-clang-relwithdebinfo",
      "configuration": "RelWithDebInfo",
      "jobs": 16
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release",
      "configuration": "Release",
      "jobs": 16
    },
    {
      "name": "windows-clang-relwithdebinfo-noprof",
      "configurePreset": "windows-clang-relwithdebinfo-noprof",
      "configuration": "RelWithDebInfo",
      "jobs": 16
    },
    {
      "name": "windows-clang-release-noprof",
      "configurePreset": "windows-clang-release-noprof",
      "configuration": "Release",
      "jobs": 16
    },
    {
      "name": "macos-relwithdebinfo",
      "configurePreset": "macos-relwithdebinfo",
      "configuration": "RelWithDebInfo",
      "jobs": 10
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "configuration": "Debug",
      "jobs": 10
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "configuration": "Release",
      "jobs": 10
    }
  ],
  "testPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
