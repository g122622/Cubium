{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "minecraft-reborn",
  "version": "0.1.0",
  "description": "Modern Minecraft Clone with Client-Server Architecture",
  "dependencies": [
    "glm",
    "spdlog",
    "nlohmann-json",
    "asio",
    "stb",
    "zlib",
    "openssl",
    "libarchive",
    "zstd",
    {
      "name": "rocksdb",
      "features": [
        "zstd"
      ]
    },
    "entt",
    "abseil",
    "leveldb",
    "gflags",
    "asmjit",
    "simdjson"
  ],
  "features": {
    "server": {
      "description": "Dedicated server terminal",
      "dependencies": [
        "ftxui"
      ]
    },
    "tests": {
      "description": "Unit test framework",
      "dependencies": [
        "gtest"
      ]
    },
    "benchmarks": {
      "description": "Performance benchmarks",
      "dependencies": [
        "benchmark"
      ]
    },
    "client": {
      "description": "Client rendering, audio and client tests",
      "dependencies": [
        "glfw3",
        "openal-soft",
        "vulkan",
        "vulkan-memory-allocator"
      ]
    }
  },
  "builtin-baseline": "39a6cc0e44641977a7ccdfdb01a14eaf832aa330"
}
