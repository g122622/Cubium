{
  "id": "execute/positioned",
  "title": "positioned 与 at 修改后的相对坐标落点",
  "category": "execute",
  "setup": [
    "/fill {x-2} {y} {z-2} {x+2} {y} {z+2} minecraft:air"
  ],
  "steps": [
    { "command": "/execute positioned {x} {y} {z} run setblock ~ ~ ~ minecraft:stone" },
    { "command": "/execute positioned {x} {y} {z} run setblock ~1 ~ ~1 minecraft:dirt" },
    { "command": "/execute positioned {x} {y} {z} run say positioned-ok" }
  ],
  "probes": [
    { "key": "block_center", "command": "/execute if block {x} {y} {z} minecraft:stone run say yes" },
    { "key": "block_offset", "command": "/execute if block {x+1} {y} {z+1} minecraft:dirt run say yes" },
    { "key": "under_player", "command": "/execute at @s if block ~ ~-1 ~ minecraft:stone run say yes" }
  ],
  "knownDiffs": []
}
