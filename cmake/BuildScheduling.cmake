# 本地编译同时受核心数与可用内存约束；分布式构建显式传入远端槽位数。
set(MC_COMPILE_JOBS "" CACHE STRING "Maximum concurrent compilations (empty selects CPU/memory limit)")
if(MC_COMPILE_JOBS STREQUAL "")
    cmake_host_system_information(RESULT _mc_cores QUERY NUMBER_OF_LOGICAL_CORES)
    cmake_host_system_information(RESULT _mc_memory_mb QUERY AVAILABLE_PHYSICAL_MEMORY)
    math(EXPR _mc_cpu_jobs "${_mc_cores} - 2")
    math(EXPR _mc_memory_jobs "${_mc_memory_mb} / 1536")
    if(_mc_cpu_jobs LESS 1)
        set(_mc_cpu_jobs 1)
    endif()
    if(_mc_memory_jobs LESS 1)
        set(_mc_memory_jobs 1)
    endif()
    if(_mc_cpu_jobs LESS _mc_memory_jobs)
        set(_mc_compile_jobs ${_mc_cpu_jobs})
    else()
        set(_mc_compile_jobs ${_mc_memory_jobs})
    endif()
elseif(MC_COMPILE_JOBS MATCHES "^[1-9][0-9]*$")
    set(_mc_compile_jobs ${MC_COMPILE_JOBS})
else()
    message(FATAL_ERROR "MC_COMPILE_JOBS must be empty or a positive integer")
endif()
set_property(GLOBAL APPEND PROPERTY JOB_POOLS mc_compile=${_mc_compile_jobs} mc_link=1)
set(CMAKE_JOB_POOL_COMPILE mc_compile)
set(CMAKE_JOB_POOL_LINK mc_link)
message(STATUS "Build scheduling: ${_mc_compile_jobs} concurrent compilations, 1 link")
